# Copy to .env in this directory. This example contains no credentials or
# usable secrets. Never commit the resulting .env file.

# Default local-only listener. Keep this on loopback when using either the
# shared reverse-proxy topology or the standalone HTTPS profile. The active
# deployment sets GO_PUBLIC_ORIGIN=https://go.pixmoving.net only in its ignored
# mode-0600 .env; do not turn that deployment value into a credential template.
GO_BIND_IP=127.0.0.1
GO_HOST_PORT=3210
GO_PUBLIC_ORIGIN=http://127.0.0.1:3210

# MCP OAuth resource-server verification. Empty values mean OAuth is not
# configured and the protected-resource metadata endpoint must fail closed.
GO_OAUTH_ISSUER=
GO_OAUTH_AUDIENCE=
GO_OAUTH_JWKS_URI=
# Optional alternative to GO_OAUTH_JWKS_URI. Keep JSON on one quoted line.
GO_OAUTH_JWKS_JSON=
GO_OAUTH_REQUIRED_SCOPES=
GO_OAUTH_AUTHORIZATION_SERVERS=
GO_OAUTH_ALLOWED_ALGORITHMS=
GO_OAUTH_CLOCK_SKEW_SECONDS=60

# Trusted Web identity boundary. Generate GO_WEB_IDENTITY_SECRET as at least
# 32 random bytes rendered as lowercase hexadecimal.
GO_WEB_IDENTITY_MODE=trusted-proxy
GO_WEB_IDENTITY_SECRET=
GO_WEB_IDENTITY_SECRET_HEADER=x-go-web-identity-secret
GO_WEB_IDENTITY_ID_HEADER=x-go-web-identity-id
GO_WEB_IDENTITY_EMAIL_HEADER=x-go-web-identity-email
GO_WEB_IDENTITY_NAME_HEADER=x-go-web-identity-name

# GO Society owner bootstrap and private identifier binding. Prefer the exact
# stable `sub` claim from the configured OIDC issuer. Self-hosted OIDC and
# trusted-proxy identities cannot become owner through the legacy Sites email
# fallback. Set the subject before authenticated owner use.
GO_SOCIETY_OWNER_SUBJECT=
# Generate both HMAC values independently as at least 32 random bytes (64
# hexadecimal characters). They must differ from each other and every other
# secret in this file.
GO_SOCIETY_PRINCIPAL_HMAC_SECRET=
GO_SOCIETY_THREAD_HMAC_SECRET=

# Optional project-scoped HTTPS gateway. Leave these blank for local-only use.
GO_DOMAIN=
CADDY_ACME_EMAIL=
GO_HTTPS_BIND_IP=0.0.0.0

# oauth2-proxy Web login client. Its issuer must exactly equal
# GO_OAUTH_ISSUER. The user-id claim is fixed to `sub` in compose.yaml so Web
# and MCP principal linking use the same issuer-qualified stable subject.
OAUTH2_PROXY_OIDC_ISSUER_URL=
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_EMAIL_DOMAINS=
OAUTH2_PROXY_SCOPE=openid profile email
