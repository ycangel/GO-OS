{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-os.org/schemas/exception-spec.schema.json",
  "title": "GO OS ExceptionSpec",
  "version": "0.2.0",
  "type": "object",
  "required": ["id", "mission_ref", "detected_at", "condition", "severity", "authority_status", "disposition"],
  "properties": {
    "id": {"type": "string"},
    "mission_ref": {"type": "string"},
    "detected_at": {"type": "string", "format": "date-time"},
    "condition": {"type": "string"},
    "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
    "authority_status": {"enum": ["within_authority", "near_limit", "outside_authority", "unknown"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "immediate_containment": {"type": "array", "items": {"type": "string"}},
    "disposition": {"enum": ["continue", "retry", "adapt", "pause", "rollback", "escalate", "terminate", "recompile"]},
    "escalate_to": {"type": ["string", "null"]},
    "recurrence_key": {"type": ["string", "null"]},
    "recurrence_count": {"type": "integer", "minimum": 1},
    "structural_review_required": {"type": "boolean"},
    "learning_target": {"enum": ["none", "mission", "authority", "policy", "capability", "architecture", "strategy", "memory"]},
    "resolution": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}