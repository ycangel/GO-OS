{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-os.org/schemas/v0.5/deliberation-session.schema.json",
  "title": "GO OS DeliberationSession",
  "description": "Normative v0.5 contract for structured Human-AI reasoning. The session records alternatives and evidence; it does not transfer human accountability to an agent.",
  "version": "0.5.0",
  "x-go-os-status": "normative",
  "type": "object",
  "required": [
    "id",
    "cognitive_event_ref",
    "participants",
    "hypotheses",
    "evidence_refs",
    "arguments",
    "accountable_human",
    "status",
    "created_at"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "cognitive_event_ref": {"type": "string", "minLength": 1},
    "participants": {
      "type": "object",
      "required": ["humans", "agents"],
      "properties": {
        "humans": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "agents": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "hypotheses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "arguments": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "alternative_interpretations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "accountable_human": {"type": "string", "minLength": 1},
    "decision": {
      "type": ["object", "null"],
      "required": ["summary", "decision_owner"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "decision_owner": {"type": "string", "minLength": 1},
        "rationale": {"type": "string"}
      },
      "additionalProperties": true
    },
    "learning_candidate": {"type": ["string", "null"]},
    "status": {"enum": ["open", "deliberating", "resolved", "closed_without_decision"]},
    "created_at": {"type": "string", "format": "date-time"},
    "resolved_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "resolved"}}, "required": ["status"]},
      "then": {"required": ["decision", "resolved_at"], "properties": {"decision": {"type": "object"}}}
    }
  ],
  "additionalProperties": true
}
