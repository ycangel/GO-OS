{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-os.org/schemas/v0.5/cognitive-event.schema.json",
  "title": "GO OS CognitiveEvent",
  "description": "Normative v0.5 contract for a trigger that requires the organization to examine evidence, uncertainty, an exception pattern, or a capability gap.",
  "version": "0.5.0",
  "x-go-os-status": "normative",
  "type": "object",
  "required": [
    "id",
    "type",
    "trigger",
    "context",
    "questions",
    "expected_decision",
    "accountable_human",
    "human_review_required",
    "status",
    "created_at"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "type": {
      "enum": ["evidence_conflict", "exception_pattern", "strategic_uncertainty", "capability_gap"]
    },
    "trigger": {"type": "string", "minLength": 1},
    "context": {"type": "object", "minProperties": 1, "additionalProperties": true},
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "exception_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "participants": {
      "type": "object",
      "required": ["humans", "agents"],
      "properties": {
        "humans": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "agents": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "expected_decision": {"type": "string", "minLength": 1},
    "accountable_human": {"type": "string", "minLength": 1},
    "human_review_required": {"type": "boolean"},
    "status": {"enum": ["open", "deliberating", "resolved", "converted_to_evolution", "closed"]},
    "created_at": {"type": "string", "format": "date-time"},
    "resolved_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"type": {"enum": ["evidence_conflict", "strategic_uncertainty"]}},
        "required": ["type"]
      },
      "then": {"properties": {"human_review_required": {"const": true}}}
    }
  ],
  "additionalProperties": true
}
