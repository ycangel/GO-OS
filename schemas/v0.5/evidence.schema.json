{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-os.org/schemas/v0.5/evidence.schema.json",
  "title": "GO OS Evidence",
  "description": "Normative v0.5 contract for traceable observations and clearly labeled claims. EvidenceSpec is retained as a legacy alias.",
  "version": "0.5.0",
  "x-go-os-status": "normative",
  "type": "object",
  "required": [
    "id",
    "claim_ref",
    "claim_type",
    "observation",
    "source",
    "provenance",
    "observed_at",
    "confidence",
    "quality",
    "validation_status"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "claim_ref": {"type": "string", "minLength": 1},
    "claim_type": {
      "enum": ["observed_fact", "reported_claim", "inference", "calculation", "recommendation", "target"]
    },
    "observation": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "provenance": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "quality": {
      "type": "object",
      "required": ["freshness", "fidelity", "independence"],
      "properties": {
        "freshness": {"enum": ["current", "aging", "stale", "unknown"]},
        "fidelity": {"enum": ["direct", "derived", "reported", "inferred"]},
        "independence": {"enum": ["independent", "partially_independent", "dependent", "unknown"]}
      },
      "additionalProperties": true
    },
    "validation_status": {"enum": ["unverified", "verified", "disputed", "superseded"]},
    "validated_by": {"type": ["string", "null"]},
    "supports": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "contradicts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "alternative_interpretations": {"type": "array", "items": {"type": "string"}},
    "missing_observations": {"type": "array", "items": {"type": "string"}},
    "decision_impact": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"validation_status": {"const": "verified"}}, "required": ["validation_status"]},
      "then": {
        "required": ["validated_by"],
        "properties": {"validated_by": {"type": "string", "minLength": 1}}
      }
    }
  ],
  "additionalProperties": true
}
