{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-os.org/schemas/v0.5/cognitive-commit.schema.json",
  "title": "GO OS CognitiveCommit",
  "description": "Normative v0.5 supporting contract for the evidence-backed, human-owned transition between cognitive versions.",
  "version": "0.5.0",
  "x-go-os-status": "normative",
  "x-go-os-role": "supporting-object",
  "type": "object",
  "required": [
    "id",
    "trigger",
    "previous_version_ref",
    "new_version_ref",
    "evidence_refs",
    "deliberation_refs",
    "decision_owner",
    "decision_owner_type",
    "summary",
    "created_at"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "trigger": {"type": "string", "minLength": 1},
    "previous_version_ref": {"type": ["string", "null"]},
    "new_version_ref": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "deliberation_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evolution_proposal_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decision_owner": {"type": "string", "minLength": 1},
    "decision_owner_type": {"const": "human"},
    "summary": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
