{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-os.org/schemas/v0.5/learning-record.schema.json",
  "title": "GO OS LearningRecord",
  "description": "Normative v0.5 contract for a traceable learning candidate or ratified update. A record does not change policy or authority by itself.",
  "version": "0.5.0",
  "x-go-os-status": "normative",
  "type": "object",
  "required": [
    "id",
    "source_type",
    "source_ref",
    "learning_statement",
    "claim_type",
    "evidence_refs",
    "validation_status",
    "accountable_human",
    "created_at"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["deliberation", "evidence", "exception", "mission"]},
    "source_ref": {"type": "string", "minLength": 1},
    "learning_statement": {"type": "string", "minLength": 1},
    "claim_type": {"enum": ["observed_pattern", "inference", "hypothesis", "validated_learning"]},
    "changed_belief": {"type": ["string", "null"]},
    "capability_impact": {"type": ["string", "null"]},
    "reusable_pattern": {"type": ["string", "null"]},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "counter_evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "validation_status": {"enum": ["candidate", "observed", "corroborated", "refuted", "superseded"]},
    "accountable_human": {"type": "string", "minLength": 1},
    "created_by": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
