{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-os.org/schemas/authority-grant.schema.json",
  "title": "GO OS AuthorityGrant",
  "version": "0.2.0",
  "type": "object",
  "required": ["id", "grantor", "grantee", "accountable_human", "scope", "allowed_actions", "limits", "escalation", "revocation"],
  "properties": {
    "id": {"type": "string"},
    "grantor": {"type": "string"},
    "grantee": {"type": "string"},
    "accountable_human": {"type": "string"},
    "scope": {"type": "string"},
    "allowed_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "prohibited_actions": {"type": "array", "items": {"type": "string"}},
    "resource_rights": {"type": "object", "additionalProperties": true},
    "limits": {"type": "object", "description": "Per-action and aggregate exposure limits.", "additionalProperties": true},
    "reversibility_ceiling": {"enum": ["reversible_only", "costly_to_reverse_allowed", "irreversible_allowed"]},
    "evidence_obligations": {"type": "array", "items": {"type": "string"}},
    "escalation": {"type": "array", "items": {"type": "string"}},
    "conflict_rules": {"type": "array", "items": {"type": "string"}},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "revocation": {"type": "object", "required": ["revocable"], "properties": {"revocable": {"type": "boolean"}, "revoked_by": {"type": "array", "items": {"type": "string"}}, "conditions": {"type": "array", "items": {"type": "string"}}}},
    "self_expansion_allowed": {"const": false}
  },
  "additionalProperties": true
}